{
  "name": "@opoha/plugin-dhl",
  "version": "1.0.0",
  "description": "Official Opoha DHL carrier shipping plugin (Phase 2 B-04 rate quote stubs)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js"
    }
  },
  "files": [
    "dist",
    "opoha.plugin.json"
  ],
  "opoha": {
    "id": "dhl",
    "version": "1.0.0",
    "contractVersion": "0.1",
    "entry": "dist/index.js",
    "displayName": "DHL",
    "description": "Registers a DHL Express carrier shipping method with rate quote stubs",
    "dependsOn": [],
    "required": false,
    "engines": {
      "shipping": [
        "dhl"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opoha/plugin-sdk": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "0.3.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opoha/typescript-config": "^1.0.0",
    "@opoha/vitest-config": "^1.0.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "packageManager": "pnpm@11.7.0"
}
